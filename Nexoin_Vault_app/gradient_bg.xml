button_transparent.xml : 
<?xml version="1.0" encoding="utf-8"?>
<!-- res/drawable/button_transparent_border.xml -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#20008000" /> <!-- Slight green tint on press -->
            <stroke
                android:width="1dp"
                android:color="#76CDF4" />
            <corners android:radius="20dp" /> <!-- Optional: Rounded corners -->
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@android:color/transparent" /> <!-- Transparent background -->
            <solid android:color="@color/t_white" />
            <stroke
                android:width="1dp"
                android:color="#111211" /> <!-- Green border -->
            <corners android:radius="50dp" />
        </shape>
    </item>
</selector>
